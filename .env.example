# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Quick start:
#   cp .env.example .env       (Linux / macOS / WSL)
#   copy .env.example .env     (Windows cmd)
#   # then edit .env to set LLM_API_KEY
#
# The Windows start_agent_*.bat scripts under bat/ source this file via
# bat\_load_env.bat, so the .env value of LLM_API_KEY is used at runtime.
# LLM_PROVIDER / LLM_MODEL / LLM_BASE_URL are still set inside each bat
# (they're not secrets) — edit the bat to change provider.

# ── LLM Configuration ─────────────────────────────────────────
# Which provider to use. Supported: anthropic | openai
LLM_PROVIDER=anthropic

# Your LLM API key. Required. Never commit a real value.
# Format depends on the provider:
#   Anthropic: sk-ant-...
#   OpenAI:    sk-...
LLM_API_KEY=sk-replace-me-with-your-real-key

# Optional. Only set if you are using an Anthropic-compatible proxy
# (e.g. minimaxi.com, MiMo, NVIDIA NIM). Leave blank for the
# provider's default endpoint.
# LLM_BASE_URL=https://api.anthropic.com

# Optional. Model name. Provider-specific.
#   Anthropic: claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5
#   OpenAI:    gpt-4o | gpt-4o-mini
LLM_MODEL=claude-sonnet-4-6

# ── Data Path ─────────────────────────────────────────────────
# Optional. Absolute path to the JSON output directory.
# Leave blank to use the default <project>/backend/data/output.
# Setting this to a relative path is ignored (it would resolve against
# the current working directory, which is unreliable).
# WATER_DATA_DIR=/absolute/path/to/backend/data/output
